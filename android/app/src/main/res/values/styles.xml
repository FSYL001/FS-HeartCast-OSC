<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ============================================================
         基底主题
         ============================================================ -->

    <style name="ThemeBase_Dark" parent="@android:style/Theme.Material.NoActionBar">
        <item name="bg">@color/dk_bg</item>
        <item name="surface">@color/dk_surface</item>
        <item name="surfaceAlt">@color/dk_surface_alt</item>
        <item name="hairline">@color/dk_hairline</item>
        <item name="textPrimary">@color/dk_text</item>
        <item name="textSecondary">@color/dk_text_secondary</item>
        <item name="textMuted">@color/dk_text_muted</item>
        <item name="heartRate">@color/heart_dark</item>
        <item name="success">@color/success_dark</item>
        <item name="danger">@color/danger_dark</item>
        <item name="rippleColor">@color/dk_ripple</item>

        <item name="android:windowBackground">@color/dk_bg</item>
        <item name="android:colorBackground">@color/dk_bg</item>
        <item name="android:statusBarColor">@color/dk_bg</item>
        <item name="android:navigationBarColor">@color/dk_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:textColorPrimary">@color/dk_text</item>
        <item name="android:textColorSecondary">@color/dk_text_secondary</item>
        <item name="android:textColorHint">@color/dk_text_muted</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="ThemeBase_Light" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="bg">@color/lt_bg</item>
        <item name="surface">@color/lt_surface</item>
        <item name="surfaceAlt">@color/lt_surface_alt</item>
        <item name="hairline">@color/lt_hairline</item>
        <item name="textPrimary">@color/lt_text</item>
        <item name="textSecondary">@color/lt_text_secondary</item>
        <item name="textMuted">@color/lt_text_muted</item>
        <item name="heartRate">@color/heart_light</item>
        <item name="success">@color/success_light</item>
        <item name="danger">@color/danger_light</item>
        <item name="rippleColor">@color/lt_ripple</item>

        <item name="android:windowBackground">@color/lt_bg</item>
        <item name="android:colorBackground">@color/lt_bg</item>
        <item name="android:statusBarColor">@color/lt_bg</item>
        <item name="android:navigationBarColor">@color/lt_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:textColorPrimary">@color/lt_text</item>
        <item name="android:textColorSecondary">@color/lt_text_secondary</item>
        <item name="android:textColorHint">@color/lt_text_muted</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

