    <!-- ============================================================
         排版
         ============================================================ -->

    <style name="Text" />

    <style name="Text.SectionLabel">
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">?attr/textMuted</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Text.CardTitle">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">?attr/textPrimary</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="Text.PageTitle">
        <item name="android:textSize">26sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">?attr/textPrimary</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="Text.Body">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?attr/textSecondary</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="Text.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">?attr/textMuted</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="Text.RowTitle">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">?attr/textPrimary</item>
    </style>

    <style name="Text.RowValue">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?attr/textMuted</item>
    </style>

    <!-- ============================================================
         组件
         ============================================================ -->

    <style name="Card">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:elevation">10dp</item>
        <item name="android:outlineProvider">background</item>
        <item name="android:clipToOutline">true</item>
        <item name="android:padding">@dimen/card_padding</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="Button.Pill" parent="@android:style/Widget.Material.Button">
        <item name="android:minHeight">@dimen/pill_height</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingLeft">18dp</item>
        <item name="android:paddingRight">18dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="Button.Pill.Primary">
        <item name="android:background">@drawable/bg_pill_primary</item>
        <item name="android:textColor">?attr/accentOn</item>
    </style>

    <style name="Button.Pill.Ghost">
        <item name="android:background">@drawable/bg_pill_ghost</item>
        <item name="android:textColor">?attr/textPrimary</item>
    </style>

    <style name="Input" parent="@android:style/Widget.Material.EditText">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:textColor">?attr/textPrimary</item>
        <item name="android:textColorHint">?attr/textMuted</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:minHeight">46dp</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="Switch" parent="@android:style/Widget.Material.CompoundButton.Switch">
        <item name="android:minHeight">28dp</item>
    </style>

</resources>
