<Window x:Class="HOSC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HOSC.Localization"
        Title="{Binding [AppTitle], Source={x:Static local:AppResources.Instance}}"
        Width="960"
        Height="620"
        MinWidth="820"
        MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Closing="Window_Closing">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Assets/Logo.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="SectionCard" TargetType="{x:Type Border}">
                <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="14" />
            </Style>

            <Style x:Key="SectionTitle" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                <Setter Property="Margin" Value="0,0,0,10" />
            </Style>

            <Style x:Key="FieldLabel" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Margin" Value="0,10,0,4" />
            </Style>

            <Style x:Key="StatusTextStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="DataGridTextCell" TargetType="{x:Type TextBlock}">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Image Source="{StaticResource AppLogo}"
                       Width="34"
                       Height="34"
                       Stretch="Uniform"
                       VerticalAlignment="Center" />
                <TextBlock Text="FS-HeartCast-OSC"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="{DynamicResource AccentBrush}"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="ScanStatusText"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0" />
                <Button x:Name="ScanToggleButton" Click="ScanToggle_Click" />
                <Button Content="{Binding [ClearList], Source={x:Static local:AppResources.Instance}}"
                        Click="ClearList_Click" />
                <Button Content="{Binding [SettingsButton], Source={x:Static local:AppResources.Instance}}"
                        Click="SettingsButton_Click" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource SectionCard}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}"
                                       Margin="0,0,0,2"
                                       Text="{Binding [LiveHeartRate], Source={x:Static local:AppResources.Instance}}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="LiveBpmText"
                                           Text="--"
                                           FontSize="56"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           LineHeight="64" />
                                <TextBlock Text="{Binding [DeviceBpm], Source={x:Static local:AppResources.Instance}}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="10,0,0,6"
                                           VerticalAlignment="Bottom" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <TextBlock DockPanel.Dock="Top"
                               Style="{StaticResource SectionTitle}"
                               Text="{Binding [DevicesHeader], Source={x:Static local:AppResources.Instance}}" />
                    <TextBlock x:Name="NoDevicesText"
                               DockPanel.Dock="Top"
                               Style="{StaticResource StatusTextStyle}"
                               Text="{Binding [NoDevices], Source={x:Static local:AppResources.Instance}}"
                               Margin="0,0,0,8"
                               Visibility="Collapsed" />

                    <DataGrid x:Name="DevicesGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeRows="False"
                              CanUserSortColumns="False"
                              SelectionMode="Single"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource GridLineBrush}"
                              BorderBrush="{DynamicResource BorderBrush}"
                              BorderThickness="1"
                              Background="{DynamicResource PanelBackgroundBrush}"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              RowHeight="36"
                              ColumnHeaderHeight="34"
                              SelectionChanged="DevicesGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{Binding [DeviceName], Source={x:Static local:AppResources.Instance}}"
                                                Binding="{Binding DisplayName}"
                                                Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource DataGridTextCell}">
                                        <Setter Property="Margin" Value="10,0,0,0" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="{Binding [DeviceBpm], Source={x:Static local:AppResources.Instance}}"
                                                Binding="{Binding BpmText}"
                                                Width="62">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource DataGridTextCell}">
                                        <Setter Property="FontWeight" Value="Bold" />
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="{Binding [DeviceSignal], Source={x:Static local:AppResources.Instance}}"
                                                Binding="{Binding SignalText}"
                                                Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource DataGridTextCell}" />
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="{Binding [DeviceStatus], Source={x:Static local:AppResources.Instance}}"
                                                Binding="{Binding StatusText}"
                                                Width="92">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource DataGridTextCell}" />
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="{Binding [DeviceAddress], Source={x:Static local:AppResources.Instance}}"
                                                Binding="{Binding AddressText}"
                                                Width="118">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource DataGridTextCell}" />
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="{x:Type DataGridColumnHeader}">
                                <Setter Property="Background" Value="{DynamicResource HeaderBackgroundBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Padding" Value="10,4" />
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.CellStyle>
                            <Style TargetType="{x:Type DataGridCell}">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            </Style>
                        </DataGrid.CellStyle>

                        <DataGrid.RowStyle>
                            <Style TargetType="{x:Type DataGridRow}">
                                <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                        <Setter Property="Opacity" Value="0.5" />
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource RowHoverBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource RowSelectedBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource SectionCard}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}"
                                   Text="{Binding [VrchatHeader], Source={x:Static local:AppResources.Instance}}" />

                        <CheckBox x:Name="OscEnabledCheckBox"
                                  Content="{Binding [EnableVrchat], Source={x:Static local:AppResources.Instance}}"
                                  Checked="OscEnabledChanged"
                                  Unchecked="OscEnabledChanged" />

                        <TextBlock Style="{StaticResource FieldLabel}"
                                   Text="{Binding [ActiveDeviceLabel], Source={x:Static local:AppResources.Instance}}" />
                        <TextBlock x:Name="ActiveDeviceText"
                                   Style="{StaticResource StatusTextStyle}"
                                   Text="{Binding [ActiveDeviceNone], Source={x:Static local:AppResources.Instance}}" />
                        <Button x:Name="ConnectButton"
                                Content="{Binding [Connect], Source={x:Static local:AppResources.Instance}}"
                                Margin="0,8,0,0"
                                Click="Connect_Click" />

                        <TextBlock Style="{StaticResource FieldLabel}"
                                   Text="{Binding [AddressLabel], Source={x:Static local:AppResources.Instance}}" />
                        <TextBox x:Name="OscAddressTextBox"
                                 Text="127.0.0.1"
                                 TextChanged="OscSettingChanged" />

                        <TextBlock Style="{StaticResource FieldLabel}"
                                   Text="{Binding [PortLabel], Source={x:Static local:AppResources.Instance}}" />
                        <TextBox x:Name="OscPortTextBox"
                                 Text="9000"
                                 Width="110"
                                 HorizontalAlignment="Left"
                                 TextChanged="OscSettingChanged" />

                        <TextBlock Style="{StaticResource FieldLabel}"
                                   Text="{Binding [HrAddressLabel], Source={x:Static local:AppResources.Instance}}" />
                        <TextBox x:Name="OscHrAddressTextBox"
                                 Text="/avatar/parameters/HR"
                                 TextChanged="OscSettingChanged" />

                        <TextBlock Style="{StaticResource FieldLabel}"
                                   Text="{Binding [BeatAddressLabel], Source={x:Static local:AppResources.Instance}}" />
                        <TextBox x:Name="OscBeatAddressTextBox"
                                 Text="/avatar/parameters/isHRBeat"
                                 TextChanged="OscSettingChanged" />

                        <Button x:Name="OscTestButton"
                                Content="{Binding [OscTest], Source={x:Static local:AppResources.Instance}}"
                                Margin="0,12,0,0"
                                Click="OscTest_Click" />
                        <TextBlock x:Name="OscStatusText"
                                   Style="{StaticResource StatusTextStyle}"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

    </Grid>
</Window>
